{
  "extends": ["html-validate:recommended", "html-validate:a11y"],
  "rules": {
    "no-trailing-whitespace": "off",
    "void-style": "off",
    "doctype-style": "off",
    "long-title": "off",
    "no-inline-style": "error",
    "no-raw-characters": ["error", { "relaxed": true }],
    "svg-focusable": "off"
  }
}
